# ──────────────────────────────────────────────────────────────
# BharatX Group — environment variables
# Copy to `.env` and fill in the values you have.
# NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────

# ── Frontend (Vite) ───────────────────────────────────────────
# Base URL of the API. Leave empty to use same-origin `/api`
# (Vite dev proxy handles this locally; use a reverse proxy in
# production, or point this at your deployed API host).
VITE_API_URL=

# Google Analytics 4 measurement ID (optional). When set, events
# are pushed to window.dataLayer for GA4. Never hardcode in source.
VITE_GA_ID=

# ── Backend (Express) ─────────────────────────────────────────
PORT=5000

# MongoDB connection string (Atlas recommended).
# Without this, the API runs in memory-only mode (dev convenience).
MONGO_URI=

# Secret used to sign JWT tokens (admin auth). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins for CORS (your frontend host).
CORS_ORIGIN=http://localhost:5173

# Max contact submissions per IP per 15 minutes.
RATE_LIMIT_MAX=6

# ── Admin (optional) ──────────────────────────────────────────
# When both are set, /admin unlocks with JWT-protected APIs.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (optional — Nodemailer SMTP) ────────────────────────
# When MAIL_HOST + MAIL_TO are set, contact inquiries trigger a
# notification email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
